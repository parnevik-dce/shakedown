{
  "expo": {
    "name": "Shakedown",
    "slug": "shakedown",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "shakedown",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parnevik.shakedown",
      "appleTeamId": "T8L3J2N9WA"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8C1620",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#8C1620"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Shakedown needs access to your photos so you can attach receipts to expenses.",
          "cameraPermission": "Shakedown needs the camera so you can take a photo of a receipt."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Shakedown needs access to your contacts so you can invite people to a group."
        }
      ],
      "./plugins/withDisableUserScriptSandboxing.js"
    ]
  }
}
